{
    "servers": {
        "vscode_postgres": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-postgres",
                "postgresql://postgres:rasberry@host.docker.internal:5432/postgres"
            ]
        },
        "render_postgres": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-postgres",
                "[External Database URL]?sslmode=require"
            ]
        }
    }
}